@import "tailwindcss";

:root {
  /* Brand colours */
  --colour-navy-950: #06172e;
  --colour-navy-900: #0a2140;
  --colour-navy-800: #123052;

  --colour-gold-500: #e8b11f;
  --colour-gold-600: #cc9400;
  --colour-gold-100: #fff5d2;

  --colour-green-600: #237a55;

  /* Neutral colours */
  --colour-white: #ffffff;
  --colour-background: #f7f9fb;
  --colour-surface: #ffffff;
  --colour-text: #10233f;
  --colour-muted: #5f6f86;
  --colour-border: #dce3ea;

  /* Layout */
  --container-width: 1180px;
  --section-spacing: 112px;
  --section-spacing-mobile: 72px;

  /* Border radius */
  --radius-small: 12px;
  --radius-medium: 22px;
  --radius-large: 32px;
  --radius-pill: 999px;

  /* Shadows */
  --shadow-small: 0 10px 30px rgba(6, 23, 46, 0.08);
  --shadow-medium: 0 20px 55px rgba(6, 23, 46, 0.12);

  /* Animation */
  --transition-fast: 180ms ease;
  --transition-standard: 280ms ease;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background: var(--colour-white);
  color: var(--colour-text);
  line-height: 1.6;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
  display: block;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
a {
  -webkit-tap-highlight-color: transparent;
}

button,
input,
textarea,
select {
  font: inherit;
}

.site-container {
  width: min(
    calc(100% - 40px),
    var(--container-width)
  );
  margin-inline: auto;
}

.section {
  padding-block: var(--section-spacing);
}

.section-eyebrow {
  margin: 0 0 18px;
  color: var(--colour-gold-600);
  font-size: 0.82rem;
  font-weight: 800;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.section-heading {
  max-width: 780px;
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.4rem, 5vw, 4.6rem);
  font-weight: 500;
  line-height: 1.04;
  letter-spacing: -0.035em;
}

.section-description {
  max-width: 680px;
  margin: 24px 0 0;
  color: var(--colour-muted);
  font-size: 1.08rem;
  line-height: 1.75;
}

@media (max-width: 768px) {
  .site-container {
    width: min(calc(100% - 28px), var(--container-width));
  }

  .section {
    padding-block: var(--section-spacing-mobile);
  }
}

/* =========================================================
   PROFESSIONAL INNER PAGE SYSTEM
   ========================================================= */

.page-hero {
  position: relative;
  overflow: hidden;
  padding: 104px 0 96px;
  background:
    radial-gradient(
      circle at 88% 12%,
      rgba(232, 177, 31, 0.16),
      transparent 30%
    ),
    radial-gradient(
      circle at 4% 90%,
      rgba(35, 122, 85, 0.08),
      transparent 30%
    ),
    var(--colour-background);
}

.page-hero::after {
  position: absolute;
  right: -150px;
  bottom: -250px;
  width: 480px;
  height: 480px;
  border: 1px solid rgba(6, 23, 46, 0.08);
  border-radius: 50%;
  content: "";
}

.page-hero-inner {
  position: relative;
  z-index: 1;
}

.page-hero-eyebrow {
  margin: 0 0 22px;
  color: var(--colour-gold-600);
  font-size: 0.84rem;
  font-weight: 850;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.page-hero h1 {
  max-width: 920px;
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3.2rem, 6vw, 6rem);
  font-weight: 500;
  line-height: 0.99;
  letter-spacing: -0.045em;
  text-wrap: balance;
}

.page-hero-description {
  max-width: 760px;
  margin: 30px 0 0;
  color: var(--colour-muted);
  font-size: clamp(1.05rem, 1.6vw, 1.2rem);
  line-height: 1.75;
}

.page-hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 34px;
}

.page-section {
  padding: 110px 0;
}

.page-section-soft {
  background: var(--colour-background);
}

.page-section-dark {
  background: var(--colour-navy-950);
  color: var(--colour-white);
}

.page-section-header {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
  align-items: end;
  gap: 60px;
  margin-bottom: 52px;
}

.page-section-header h2 {
  max-width: 760px;
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.5rem, 5vw, 4.6rem);
  font-weight: 500;
  line-height: 1.04;
  letter-spacing: -0.035em;
}

.page-section-header p {
  margin: 0;
  color: var(--colour-muted);
  font-size: 1.05rem;
  line-height: 1.75;
}

.content-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: center;
  gap: clamp(50px, 8vw, 100px);
}

.content-image {
  position: relative;
  min-height: 570px;
  overflow: hidden;
  border-radius: var(--radius-large);
  background: var(--colour-background);
  box-shadow: var(--shadow-medium);
}

.content-image img {
  width: 100%;
  height: 100%;
  min-height: 570px;
  object-fit: cover;
}

.content-copy h2 {
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.6rem, 5vw, 4.5rem);
  font-weight: 500;
  line-height: 1.03;
  letter-spacing: -0.035em;
}

.content-copy > p {
  margin: 26px 0 0;
  color: var(--colour-muted);
  font-size: 1.06rem;
  line-height: 1.78;
}

.feature-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.feature-card {
  position: relative;
  overflow: hidden;
  padding: 32px;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-medium);
  background: var(--colour-white);
  box-shadow: var(--shadow-small);
  transition:
    transform var(--transition-standard),
    border-color var(--transition-standard),
    box-shadow var(--transition-standard);
}

.feature-card:hover {
  border-color: rgba(232, 177, 31, 0.7);
  transform: translateY(-6px);
  box-shadow: var(--shadow-medium);
}

.feature-card-number {
  display: block;
  margin-bottom: 30px;
  color: var(--colour-gold-600);
  font-size: 0.82rem;
  font-weight: 850;
  letter-spacing: 0.14em;
}

.feature-card h3 {
  margin: 0;
  color: var(--colour-navy-950);
  font-size: 1.35rem;
  line-height: 1.25;
}

.feature-card p {
  margin: 14px 0 0;
  color: var(--colour-muted);
  line-height: 1.7;
}

.feature-card-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 24px;
  color: var(--colour-navy-950);
  font-weight: 800;
}

.info-list {
  display: grid;
  gap: 0;
  margin: 34px 0 0;
  padding: 0;
  list-style: none;
}

.info-list li {
  display: grid;
  grid-template-columns: 38px 1fr;
  gap: 15px;
  padding: 20px 0;
  border-bottom: 1px solid var(--colour-border);
  color: var(--colour-text);
}

.info-list-icon {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--colour-gold-100);
  color: var(--colour-gold-600);
  font-weight: 900;
}

.cta-panel {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) auto;
  align-items: center;
  gap: 50px;
  padding: 54px;
  border-radius: var(--radius-large);
  background: var(--colour-navy-950);
  color: var(--colour-white);
  box-shadow: var(--shadow-medium);
}

.cta-panel h2 {
  margin: 0;
  color: var(--colour-white);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.2rem, 4vw, 3.8rem);
  font-weight: 500;
  line-height: 1.06;
}

.cta-panel p {
  max-width: 680px;
  margin: 18px 0 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 1.04rem;
  line-height: 1.7;
}

.cta-panel-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 14px;
}

.contact-card {
  padding: 32px;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-medium);
  background: var(--colour-white);
  box-shadow: var(--shadow-small);
}

.contact-card-label {
  display: block;
  margin-bottom: 18px;
  color: var(--colour-gold-600);
  font-size: 0.8rem;
  font-weight: 850;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.contact-card h3 {
  margin: 0;
  color: var(--colour-navy-950);
  font-size: 1.25rem;
}

.contact-card p {
  margin: 12px 0 0;
  color: var(--colour-muted);
  line-height: 1.65;
}

.contact-card a {
  display: inline-block;
  margin-top: 18px;
  color: var(--colour-navy-950);
  font-weight: 800;
}

.professional-form {
  padding: 38px;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-large);
  background: var(--colour-white);
  box-shadow: var(--shadow-medium);
}

.form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.form-field {
  display: grid;
  gap: 9px;
}

.form-field-full {
  grid-column: 1 / -1;
}

.form-field label {
  color: var(--colour-navy-950);
  font-size: 0.92rem;
  font-weight: 800;
}

.form-field input,
.form-field select,
.form-field textarea {
  width: 100%;
  border: 1px solid var(--colour-border);
  border-radius: 14px;
  background: var(--colour-background);
  color: var(--colour-text);
  padding: 15px 17px;
  outline: none;
  transition:
    border-color var(--transition-fast),
    box-shadow var(--transition-fast),
    background-color var(--transition-fast);
}

.form-field textarea {
  min-height: 150px;
  resize: vertical;
}

.form-field input:focus,
.form-field select:focus,
.form-field textarea:focus {
  border-color: var(--colour-gold-500);
  background: var(--colour-white);
  box-shadow: 0 0 0 4px rgba(232, 177, 31, 0.15);
}

@media (max-width: 950px) {
  .page-section-header,
  .content-grid,
  .cta-panel {
    grid-template-columns: 1fr;
  }

  .feature-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .cta-panel-actions {
    justify-content: flex-start;
  }
}

@media (max-width: 650px) {
  .page-hero {
    padding: 72px 0 68px;
  }

  .page-hero h1 {
    font-size: clamp(2.8rem, 13vw, 4rem);
  }

  .page-hero-actions {
    flex-direction: column;
  }

  .page-hero-actions a {
    width: 100%;
  }

  .page-section {
    padding: 76px 0;
  }

  .feature-grid,
  .form-grid {
    grid-template-columns: 1fr;
  }

  .content-image,
  .content-image img {
    min-height: 430px;
  }

  .cta-panel {
    padding: 34px 24px;
  }

  .professional-form {
    padding: 25px 20px;
  }
}

/* =========================================================
   PROFESSIONAL DONATION OPTIONS
   ========================================================= */

.donation-options-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: stretch;
  gap: 24px;
}

.donation-option-card {
  position: relative;
  display: flex;
  min-width: 0;
  min-height: 430px;
  flex-direction: column;
  padding: 34px;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-large);
  background: var(--colour-white);
  box-shadow: var(--shadow-small);
  transition:
    border-color var(--transition-standard),
    box-shadow var(--transition-standard),
    transform var(--transition-standard);
}

.donation-option-card:hover {
  border-color: rgba(232, 177, 31, 0.68);
  box-shadow: var(--shadow-medium);
  transform: translateY(-7px);
}

.donation-option-featured {
  border-color: rgba(232, 177, 31, 0.78);
  background:
    linear-gradient(
      160deg,
      rgba(255, 245, 210, 0.72),
      var(--colour-white) 48%
    );
}

.donation-recommended {
  position: absolute;
  top: 23px;
  right: 23px;
  padding: 7px 12px;
  border-radius: var(--radius-pill);
  background: var(--colour-gold-500);
  color: var(--colour-navy-950);
  font-size: 0.72rem;
  font-weight: 850;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.donation-option-icon {
  width: 58px;
  height: 58px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 29px;
  border-radius: 18px;
  background: var(--colour-navy-950);
  color: var(--colour-white);
  font-size: 1.35rem;
  font-weight: 900;
  box-shadow: var(--shadow-small);
}

.donation-option-featured .donation-option-icon {
  background: var(--colour-gold-500);
  color: var(--colour-navy-950);
}

.donation-option-label {
  margin: 0 0 11px;
  color: var(--colour-gold-600);
  font-size: 0.78rem;
  font-weight: 850;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.donation-option-card h3 {
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(1.8rem, 3vw, 2.4rem);
  font-weight: 500;
  line-height: 1.08;
}

.donation-option-description {
  margin: 19px 0 30px;
  color: var(--colour-muted);
  line-height: 1.72;
}

.donation-option-button {
  width: 100%;
  margin-top: auto;
}

.donation-trust-section {
  background: var(--colour-white);
}

.donation-trust-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 42px;
}

.donation-trust-grid article {
  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 16px;
}

.donation-trust-grid article > span {
  width: 38px;
  height: 38px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--colour-gold-100);
  color: var(--colour-gold-600);
  font-weight: 900;
}

.donation-trust-grid h3 {
  margin: 0;
  color: var(--colour-navy-950);
  font-size: 1.08rem;
}

.donation-trust-grid p {
  margin: 9px 0 0;
  color: var(--colour-muted);
  line-height: 1.65;
}

@media (max-width: 950px) {
  .donation-options-grid {
    grid-template-columns: 1fr;
  }

  .donation-option-card {
    min-height: auto;
  }

  .donation-trust-grid {
    grid-template-columns: 1fr;
    gap: 28px;
  }
}

@media (max-width: 600px) {
  .donation-option-card {
    padding: 28px 22px;
    border-radius: 24px;
  }

  .donation-recommended {
    top: 18px;
    right: 18px;
  }
}

/* Navigation */

.site-header {
  position: sticky;
  top: 0;
html {
  scroll-behavior: smooth;
}  z-index: 1000;
  border-bottom: 1px solid transparent;
  background: rgba(255, 255, 255, 0.96);
  transition:
    border-color var(--transition-standard),
    box-shadow var(--transition-standard),
    background-color var(--transition-standard);
  backdrop-filter: blur(16px);
}

.site-header-scrolled {
  border-bottom-color: var(--colour-border);
  box-shadow: 0 8px 30px rgba(6, 23, 46, 0.08);
}

.navbar {
  min-height: 88px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.navbar-brand {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  gap: 13px;
}

.navbar-brand img {
  width: 58px;
  height: 58px;
  object-fit: contain;
}

.navbar-brand-text {
  display: grid;
  line-height: 1.05;
}

.navbar-brand-text strong {
  color: var(--colour-navy-950);
  font-size: 1rem;
}

.navbar-brand-text span {
  margin-top: 5px;
  color: var(--colour-gold-600);
  font-size: 0.72rem;
  font-weight: 850;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.navbar-navigation {
  display: flex;
  align-items: center;
  gap: 28px;
}

.navbar-links {
  display: flex;
  align-items: center;
  gap: 27px;
}

.navbar-link:focus-visible,
.navbar-brand:focus-visible,
.navbar-donate-button:focus-visible {
  border-radius: 5px;
  outline: 3px solid rgba(232, 177, 31, 0.45);
  outline-offset: 5px;
}

.navbar-donate-button {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12px 25px;
  border-radius: var(--radius-pill);
  background: var(--colour-gold-500);
  color: var(--colour-navy-950);
  font-weight: 850;
  transition:
    background-color var(--transition-fast),
    transform var(--transition-fast),
    box-shadow var(--transition-fast);
}

.navbar-donate-button:hover {
  background: var(--colour-gold-600);
  transform: translateY(-2px);
  box-shadow: 0 10px 24px rgba(204, 148, 0, 0.25);
}

.mobile-menu-button {
  width: 48px;
  height: 48px;
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5px;
  border: 1px solid var(--colour-border);
  border-radius: 50%;
  background: var(--colour-white);
  cursor: pointer;
}

.mobile-menu-button span {
  width: 21px;
  height: 2px;
  border-radius: 10px;
  background: var(--colour-navy-950);
}

@media (max-width: 980px) {
  .mobile-menu-button {
    display: flex;
  }

  .navbar-navigation {
    position: fixed;
    top: 88px;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 999;
    display: flex;
    visibility: hidden;
    align-items: stretch;
    flex-direction: column;
    gap: 24px;
    padding: 32px 24px;
    background: var(--colour-white);
    opacity: 0;
    transform: translateY(-14px);
    transition:
      opacity var(--transition-standard),
      visibility var(--transition-standard),
      transform var(--transition-standard);
  }

  .navbar-navigation-open {
    visibility: visible;
    opacity: 1;
    transform: translateY(0);
  }

  .navbar-links {
    align-items: stretch;
    flex-direction: column;
    gap: 4px;
  }

  .navbar-link {
    width: 100%;
    padding: 15px 4px;
    border-bottom: 1px solid var(--colour-border);
    font-size: 1.08rem;
  }

  .navbar-link::after {
    display: none;
  }

  .navbar-donate-button {
    width: 100%;
    min-height: 54px;
  }
}

@media (max-width: 520px) {
  .navbar {
    min-height: 78px;
  }

  .navbar-brand img {
    width: 48px;
    height: 48px;
  }

  .navbar-brand-text strong {
    font-size: 0.92rem;
  }

  .navbar-navigation {
    top: 78px;
  }
}

/* Hero */

.hero {
  position: relative;
  overflow: hidden;
  padding: 92px 0 110px;
  background:
    radial-gradient(
      circle at 92% 15%,
      rgba(232, 177, 31, 0.13),
      transparent 34%
    ),
    radial-gradient(
      circle at 5% 88%,
      rgba(35, 122, 85, 0.1),
      transparent 30%
    ),
    var(--colour-white);
}

.hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.04fr) minmax(420px, 0.96fr);
  align-items: center;
  gap: clamp(54px, 7vw, 104px);
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-eyebrow {
  margin: 0 0 24px;
  color: var(--colour-gold-600);
  font-size: 0.84rem;
  font-weight: 850;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.hero-content h1 {
  max-width: 720px;
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3.4rem, 5.5vw, 5.65rem);
  font-weight: 500;
  line-height: 0.99;
  letter-spacing: -0.047em;
  text-wrap: balance;
}

.hero-description {
  max-width: 640px;
  margin: 34px 0 0;
  color: var(--colour-muted);
  font-size: clamp(1.04rem, 1.4vw, 1.18rem);
  line-height: 1.75;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
  margin-top: 34px;
}

.hero-trust-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14px 24px;
  margin: 30px 0 0;
  padding: 0;
  color: var(--colour-muted);
  font-size: 0.9rem;
  font-weight: 750;
  list-style: none;
}

.hero-trust-list li {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.hero-trust-list span {
  color: var(--colour-green-600);
  font-size: 1rem;
  font-weight: 900;
}

.hero-visual {
  min-width: 0;
}

.hero-image-wrapper {
  position: relative;
  min-height: 650px;
  overflow: hidden;
  border-radius: var(--radius-large);
  background: var(--colour-background);
  box-shadow: var(--shadow-medium);
}

.hero-image {
  object-fit: cover;
  object-position: center;
  transition: transform 700ms ease;
}

.hero-image-wrapper:hover .hero-image {
  transform: scale(1.025);
}

.hero-image-shade {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    linear-gradient(
      to top,
      rgba(6, 23, 46, 0.35),
      transparent 45%
    );
}

.hero-message {
  position: absolute;
  right: 26px;
  bottom: 26px;
  left: 26px;
  z-index: 2;
  padding: 24px 28px;
  border: 1px solid rgba(255, 255, 255, 0.5);
  border-radius: var(--radius-medium);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-small);
  backdrop-filter: blur(12px);
}

.hero-message strong {
  display: block;
  color: var(--colour-navy-950);
  font-size: 1.08rem;
}

.hero-message p {
  margin: 7px 0 0;
  color: var(--colour-muted);
  line-height: 1.6;
}

@media (max-width: 1050px) {
  .hero-grid {
    grid-template-columns: 1fr 0.9fr;
    gap: 48px;
  }

  .hero-content h1 {
    font-size: clamp(3.2rem, 6vw, 4.7rem);
  }

  .hero-image-wrapper {
    min-height: 570px;
  }
}

@media (max-width: 900px) {
  .hero {
    padding: 68px 0 80px;
  }

  .hero-grid {
    grid-template-columns: 1fr;
  }

  .hero-content {
    max-width: 760px;
  }

  .hero-image-wrapper {
    min-height: 560px;
  }
}

@media (max-width: 600px) {
  .hero {
    padding: 52px 0 64px;
  }

  .hero-content h1 {
    font-size: clamp(2.65rem, 13vw, 3.65rem);
    line-height: 1.01;
  }

  .hero-description {
    margin-top: 24px;
    font-size: 1rem;
  }

  .hero-actions {
    flex-direction: column;
    margin-top: 28px;
  }

  .hero-actions .primary-button,
  .hero-actions .secondary-button {
    width: 100%;
  }

  .hero-trust-list {
    display: grid;
    gap: 11px;
  }

  .hero-image-wrapper {
    min-height: 460px;
    border-radius: 24px;
  }

  .hero-message {
    right: 14px;
    bottom: 14px;
    left: 14px;
    padding: 19px;
  }
}

/* Appeal bar */

.appeal-bar {
  background: var(--charity-navy);
  color: var(--white);
}

.appeal-content {
  min-height: 78px;
  display: flex;
  align-items: center;
  justify-content: space-between;
    gap: 24px;
}

.appeal-content p {
  margin: 0;
}

.appeal-content strong {
  color: var(--white);
}

.appeal-content a {
  flex-shrink: 0;
  color: #f6cd63;
  font-weight: 800;
}

.impact-strip {
  padding: 58px 0;
  background: var(--colour-navy-950);
  color: var(--colour-white);
}

.impact-strip-header {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 40px;
  margin-bottom: 38px;
}

.impact-strip-header .section-eyebrow {
  margin-bottom: 0;
  color: var(--colour-gold-500);
}

.impact-strip-header h2 {
  max-width: 640px;
  margin: 0;
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2rem, 4vw, 3.2rem);
  font-weight: 500;
  line-height: 1.1;
}

.impact-strip-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(255, 255, 255, 0.16);
}

.impact-strip-item {
  min-width: 0;
  padding: 34px 28px 8px 0;
}

.impact-strip-item:not(:first-child) {
  padding-left: 28px;
  border-left: 1px solid rgba(255, 255, 255, 0.16);
}

.impact-strip-marker {
  width: 34px;
  height: 34px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
  border-radius: 50%;
  background: var(--colour-gold-500);
  color: var(--colour-navy-950);
  font-weight: 900;
}

.impact-strip-item h3 {
  margin: 0;
  font-size: 1.07rem;
}

.impact-strip-item p {
  margin: 9px 0 0;
  color: rgba(255, 255, 255, 0.72);
  font-size: 0.94rem;
  line-height: 1.6;
}

@media (max-width: 900px) {
  .impact-strip-header {
    align-items: start;
    flex-direction: column;
  }

  .impact-strip-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .impact-strip-item:nth-child(3) {
    padding-left: 0;
    border-left: 0;
  }
}

@media (max-width: 560px) {
  .impact-strip-grid {
    grid-template-columns: 1fr;
  }

  .impact-strip-item,
  .impact-strip-item:not(:first-child) {
    padding: 25px 0;
    border-left: 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.16);
  }
}

/* General sections */

.section {
  padding: 96px 0;
}

.soft-section {
  background: var(--charity-soft);
}

.cream-section {
  background: var(--charity-cream);
}

.dark-section {
  background: var(--charity-navy);
  color: var(--white);
}

.section-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 60px;
  margin-bottom: 42px;
}

.section-heading h2,
.about-grid h2 {
  margin: 0;
  color: var(--charity-navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.3rem, 4vw, 4rem);
  line-height: 1.08;
}

.section-heading > p {
  max-width: 520px;
  color: var(--muted);
}

.dark-section .section-heading h2 {
  color: var(--white);
}

.dark-section .section-heading > p {
  color: #c8d3df;
}

/* About */

.about-section {
  background: var(--colour-white);
}

.about-intro {
  max-width: 1100px;
  display: grid;
  gap: 12px;
  color: var(--colour-text);
  font-size: clamp(1.05rem, 1.5vw, 1.3rem);
  line-height: 1.65;
}

.about-intro p {
  margin: 0;
}

.about-intro-label {
  font-weight: 850;
}

.about-intro-label-gold {
  color: var(--colour-gold-600);
}

.about-intro-label-navy {
  color: var(--colour-navy-950);
}

.about-intro-label-green {
  color: var(--colour-green-600);
}

.about-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  align-items: center;
  gap: clamp(56px, 8vw, 110px);
}

.about-image-card {
  position: relative;
  min-height: 590px;
  overflow: hidden;
  border-radius: var(--radius-large);
  background: var(--colour-background);
  box-shadow: var(--shadow-medium);
}

.about-image {
  width: 100%;
  height: 100%;
  min-height: 590px;
  object-fit: cover;
}

.about-image-badge {
  position: absolute;
  right: 24px;
  bottom: 24px;
  left: 24px;
  display: grid;
  gap: 5px;
  padding: 22px 24px;
  border: 1px solid rgba(255, 255, 255, 0.55);
  border-radius: var(--radius-medium);
  background: rgba(255, 255, 255, 0.94);
  box-shadow: var(--shadow-small);
  backdrop-filter: blur(12px);
}

.about-image-badge strong {
  color: var(--colour-navy-950);
  font-size: 1.05rem;
}

.about-image-badge span {
  color: var(--colour-muted);
  font-size: 0.92rem;
}

.about-copy {
  max-width: 670px;
  margin: 20px 0 0;
  color: var(--colour-muted);
  font-size: 1.05rem;
  line-height: 1.75;
}

.about-highlights {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin: 32px 0;
}

.about-highlights > div {
  padding: 22px;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-medium);
  background: var(--colour-background);
}

.about-highlights strong,
.about-highlights span {
  display: block;
}

.about-highlights strong {
  color: var(--colour-navy-950);
  font-size: 1rem;
}

.about-highlights span {
  margin-top: 7px;
  color: var(--colour-muted);
  font-size: 0.9rem;
  line-height: 1.55;
}

@media (max-width: 900px) {
  .about-grid {
    grid-template-columns: 1fr;
  }

  .about-image-card,
  .about-image {
    min-height: 520px;
  }
}

@media (max-width: 600px) {
  .about-image-card,
  .about-image {
    min-height: 430px;
  }

  .about-image-badge {
    right: 14px;
    bottom: 14px;
    left: 14px;
    padding: 18px;
  }

  .about-highlights {
    grid-template-columns: 1fr;
  }
}

.text-link {
  color: var(--charity-blue);
  font-weight: 800;
}

/* Programme cards */

.programmes-section {
  background: var(--colour-background);
}

.programmes-header {
  display: grid;
  grid-template-columns: minmax(0, 1.4fr) minmax(300px, 0.6fr);
  align-items: end;
  gap: 60px;
  margin-bottom: 54px;
}

.programmes-introduction {
  margin: 0;
  color: var(--colour-muted);
  font-size: 1.05rem;
  line-height: 1.75;
}

.programmes-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.programme-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-medium);
  background: var(--colour-white);
  box-shadow: var(--shadow-small);
  transition:
    transform var(--transition-standard),
    box-shadow var(--transition-standard),
    border-color var(--transition-standard);
}

.programme-card:hover {
  border-color: rgba(232, 177, 31, 0.65);
  transform: translateY(-8px);
  box-shadow: var(--shadow-medium);
}

.programme-card:focus-visible {
  outline: 3px solid rgba(232, 177, 31, 0.45);
  outline-offset: 5px;
}

.programme-image-wrapper {
  position: relative;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: var(--colour-background);
}

.programme-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 500ms ease;
}

.programme-card:hover .programme-image {
  transform: scale(1.045);
}

.programme-arrow {
  position: absolute;
  right: 18px;
  bottom: 18px;
  width: 44px;
  height: 44px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--colour-gold-500);
  color: var(--colour-navy-950);
  font-size: 1.15rem;
  font-weight: 900;
  box-shadow: var(--shadow-small);
  transition: transform var(--transition-fast);
}

.programme-card:hover .programme-arrow {
  transform: translateX(3px);
}

.programme-card-content {
  padding: 28px;
}

.programme-card h3 {
  margin: 0;
  color: var(--colour-navy-950);
  font-size: 1.35rem;
}

.programme-card p {
  margin: 14px 0 0;
  color: var(--colour-muted);
  line-height: 1.7;
}

.programme-link-text {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-top: 22px;
  color: var(--colour-navy-950);
  font-weight: 800;
}

@media (max-width: 950px) {
  .programmes-header {
    grid-template-columns: 1fr;
    align-items: start;
    gap: 24px;
  }

  .programmes-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 650px) {
  .programmes-grid {
    grid-template-columns: 1fr;
  }

  .programme-card-content {
    padding: 24px;
  }
}

/* Impact */

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
}

.stats-grid article {
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
}

.stats-grid strong {
  display: block;
  color: var(--charity-navy);
  font-size: 3rem;
  line-height: 1;
}

.stats-grid span {
  display: block;
  margin-top: 12px;
  color: var(--muted);
}

.transparency-panel {
  margin-top: 28px;
  padding: 34px;
  display: grid;
  grid-template-columns: 1fr 1.4fr auto;
  gap: 30px;
  align-items: center;
  border-radius: 22px;
  background: var(--charity-cream);
}

.transparency-panel h3 {
  margin: 0;
  color: var(--charity-navy);
  font-size: 1.65rem;
}

.transparency-panel p {
  margin: 0;
  color: var(--muted);
}

.transparency-panel a {
  padding: 14px 20px;
  border-radius: 999px;
  background: var(--charity-navy);
  color: var(--white);
  font-weight: 800;
}

/* Story cards */

.story-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 26px;
}

.story-card {
  overflow: hidden;
  border-radius: 22px;
  background: var(--white);
  color: var(--text);
}

.story-image {
  min-height: 280px;
  background: var(--charity-soft);
}

.story-content {
  padding: 28px;
}

.story-content span {
  color: var(--charity-gold);
  font-size: 0.75rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.story-content h3 {
  margin: 10px 0;
  color: var(--charity-navy);
  font-size: 1.6rem;
}

.story-content p {
  color: var(--muted);
}

.story-content a {
  color: var(--charity-blue);
  font-weight: 800;
}

.brand-logo {
  width: 58px;
  height: 58px;
  object-fit: contain;
  border-radius: 50%;
  background: #ffffff;
}

.section-image {
  position: relative;
  min-height: 520px;
  overflow: hidden;
  border-radius: 28px;
  box-shadow: 0 24px 65px rgba(11, 31, 58, 0.14);
}

.content-image {
  object-fit: cover;
  object-position: center;
}

.image-card {
  padding: 0;
  overflow: hidden;
}

.card-image {
  position: relative;
  min-height: 260px;
  overflow: hidden;
}

.card-content {
  padding: 28px;
}

.story-image {
  position: relative;
  min-height: 360px;
  overflow: hidden;
}

@media (max-width: 920px) {
  .section-image {
    min-height: 430px;
  }
}

@media (max-width: 640px) {
  .brand-logo {
    width: 48px;
    height: 48px;
  }

  .section-image,
  .story-image {
    min-height: 340px;
  }

  .card-image {
    min-height: 230px;
  }
}

/* Donation section */

.donation-section {
  background: linear-gradient(
    135deg,
    var(--charity-cream),
    var(--white)
  );
}

.donation-grid {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: 70px;
  align-items: center;
}

.donation-card {
  padding: 34px;
  border-radius: 22px;
  background: var(--white);
  box-shadow: var(--shadow);
}

.donation-card h3 {
  margin-top: 0;
  color: var(--charity-navy);
  font-size: 1.5rem;
}

.donation-card a {
  min-height: 50px;
  padding: 0 24px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: var(--charity-gold);
  color: #17130b;
  font-weight: 800;
}

.detailed-programme-grid {
  display: grid;
  gap: 34px;
}

.detailed-programme-card {
  display: grid;
  grid-template-columns: 0.95fr 1.05fr;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 26px;
  background: var(--white);
  box-shadow: 0 16px 42px rgba(11, 31, 58, 0.08);
}

.detailed-programme-image {
  position: relative;
  min-height: 430px;
}

.detailed-programme-content {
  padding: 46px;
}

.detailed-programme-content h2,
.impact-layout h2,
.contact-grid h2 {
  margin-top: 0;
  color: var(--charity-navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2rem, 4vw, 3.4rem);
  line-height: 1.1;
}

.detailed-programme-content h3 {
  margin-top: 28px;
  color: var(--charity-navy);
}

.detailed-programme-content li {
  margin: 10px 0;
  color: var(--muted);
}

.impact-layout {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 70px;
  align-items: start;
}

.impact-principles {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-top: 30px;
}

.impact-principles article,
.involvement-card,
.contact-details article {
  padding: 26px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: var(--white);
}

.impact-principles h3,
.involvement-card h2,
.contact-details h3 {
  margin-top: 0;
  color: var(--charity-navy);
}

.involvement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24px;
}

.involvement-card {
  padding: 36px;
}

.involvement-card p {
  margin-bottom: 24px;
  color: var(--muted);
}

.contact-details {
  display: grid;
  gap: 18px;
  margin-top: 30px;
}

.contact-details a {
  color: var(--charity-blue);
  font-weight: 800;
}

.contact-social-card {
  padding: 42px;
  border-radius: 26px;
  background: var(--charity-navy);
  color: var(--white);
}

.contact-social-card h2 {
  color: var(--white);
}

.contact-social-card a {
  display: block;
  margin: 14px 0;
  padding: 14px 18px;
  border: 1px solid rgba(255, 255, 255, 0.2);
  border-radius: 12px;
  transition: background 180ms ease;
}

.contact-social-card a:hover {
  background: rgba(255, 255, 255, 0.1);
}

@media (max-width: 920px) {
  .detailed-programme-card,
  .impact-layout {
    grid-template-columns: 1fr;
  }

  .impact-principles,
  .involvement-grid {
    grid-template-columns: 1fr;
  }

  .detailed-programme-image {
    min-height: 360px;
  }
}

@media (max-width: 640px) {
  .detailed-programme-content,
  .involvement-card,
  .contact-social-card {
    padding: 26px;
  }
}

/* Contact */

.contact-grid {
  display: grid;
  grid-template-columns: 0.8fr 1.2fr;
  gap: 70px;
}

.contact-form {
  padding: 30px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
}

.contact-form label {
  display: grid;
  gap: 8px;
  margin-bottom: 18px;
  color: var(--charity-navy);
  font-weight: 700;
}

.contact-form input,
.contact-form textarea,
.contact-form select {
  width: 100%;
  padding: 14px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: var(--white);
}

.contact-form input:focus,
.contact-form textarea:focus,
.contact-form select:focus {
  outline: 3px solid rgba(217, 170, 43, 0.2);
  border-color: var(--charity-gold);
}

.contact-form button {
  min-height: 48px;
  padding: 0 24px;
  border: 0;
  border-radius: 999px;
  background: var(--charity-gold);
  color: #17130b;
  font-weight: 800;
  cursor: pointer;
}

/* Professional AI assistant */

.foundation-ai {
  position: fixed;
  right: 24px;
  bottom: 24px;
  z-index: 200;
  font-family: Arial, Helvetica, sans-serif;
}

.foundation-ai-launcher {
  min-height: 58px;
  padding: 0 22px;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  border: 0;
  border-radius: 999px;
  background: linear-gradient(135deg, var(--charity-gold), #f0c94f);
  color: #18130a;
  box-shadow: 0 18px 48px rgba(11, 31, 58, 0.28);
  font-weight: 800;
  cursor: pointer;
}

.foundation-ai-launcher-icon {
  width: 30px;
  height: 30px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--charity-navy);
  color: white;
}

.foundation-ai-panel {
  width: min(410px, calc(100vw - 32px));
  margin-bottom: 14px;
  overflow: hidden;
  border: 1px solid rgba(11, 31, 58, 0.12);
  border-radius: 26px;
  background: white;
  box-shadow: 0 30px 90px rgba(11, 31, 58, 0.3);
}

.foundation-ai-header {
  padding: 18px 20px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background:
    radial-gradient(circle at 90% 0%, rgba(217, 170, 43, 0.3), transparent 42%),
    var(--charity-navy);
  color: white;
}

.foundation-ai-identity {
  display: flex;
  align-items: center;
  gap: 12px;
}

.foundation-ai-avatar {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 2px solid rgba(255, 255, 255, 0.35);
  border-radius: 50%;
  background: var(--charity-gold);
  color: var(--charity-navy);
  font-weight: 900;
}

.foundation-ai-identity strong,
.foundation-ai-identity span {
  display: block;
}

.foundation-ai-identity span {
  margin-top: 3px;
  color: #ccd7e3;
  font-size: 0.78rem;
}

.foundation-ai-identity span i {
  width: 7px;
  height: 7px;
  display: inline-block;
  margin-right: 6px;
  border-radius: 50%;
  background: #52d273;
}

.foundation-ai-close {
  width: 36px;
  height: 36px;
  border: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  color: white;
  font-size: 1.45rem;
  cursor: pointer;
}

.foundation-ai-body {
  background: #f4f7fa;
}

.foundation-ai-messages {
  height: 330px;
  padding: 18px;
  overflow-y: auto;
}

.foundation-ai-message {
  width: fit-content;
  max-width: 86%;
  margin-bottom: 12px;
  padding: 12px 14px;
  border-radius: 17px;
  font-size: 0.91rem;
  line-height: 1.5;
  white-space: pre-wrap;
}

.foundation-ai-message-assistant {
  border: 1px solid rgba(11, 31, 58, 0.08);
  border-bottom-left-radius: 5px;
  background: white;
  color: var(--text);
}

.foundation-ai-message-user {
  margin-left: auto;
  border-bottom-right-radius: 5px;
  background: var(--charity-navy);
  color: white;
}

.foundation-ai-suggestions {
  padding: 0 18px 16px;
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.foundation-ai-suggestions button {
  padding: 8px 11px;
  border: 1px solid rgba(11, 31, 58, 0.14);
  border-radius: 999px;
  background: white;
  color: var(--charity-navy);
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
}

.foundation-ai-form {
  padding: 13px;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 9px;
  border-top: 1px solid var(--border);
  background: white;
}

.foundation-ai-form textarea {
  min-width: 0;
  max-height: 110px;
  padding: 12px 13px;
  resize: none;
  border: 1px solid var(--border);
  border-radius: 13px;
  color: var(--text);
}

.foundation-ai-form textarea:focus {
  outline: 3px solid rgba(217, 170, 43, 0.18);
  border-color: var(--charity-gold);
}

.foundation-ai-form button {
  padding: 0 17px;
  border: 0;
  border-radius: 13px;
  background: var(--charity-gold);
  color: #18130a;
  font-weight: 800;
  cursor: pointer;
}

.foundation-ai-form button:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}

.foundation-ai-disclaimer {
  margin: 0;
  padding: 0 16px 14px;
  background: white;
  color: var(--muted);
  font-size: 0.69rem;
  line-height: 1.4;
}

.foundation-ai-typing {
  display: inline-flex;
  gap: 4px;
}

.foundation-ai-typing i {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--muted);
  animation: foundation-ai-pulse 1.2s infinite;
}

.foundation-ai-typing i:nth-child(2) {
  animation-delay: 0.15s;
}

.foundation-ai-typing i:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes foundation-ai-pulse {
  0%,
  70%,
  100% {
    opacity: 0.35;
    transform: translateY(0);
  }

  35% {
    opacity: 1;
    transform: translateY(-3px);
  }
}

@media (max-width: 640px) {
  .foundation-ai {
    right: 14px;
    bottom: 14px;
  }

  .foundation-ai-panel {
    width: calc(100vw - 28px);
  }

  .foundation-ai-messages {
    height: 300px;
  }

  .foundation-ai-launcher {
    min-height: 54px;
  }
}

/* Footer */

.footer {
  padding: 70px 0 22px;
  background: #071527;
  color: #d8e0ea;
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr 1fr;
  gap: 46px;
}

.footer-grid h3 {
  color: var(--white);
}

.footer-grid a {
  display: block;
  margin: 9px 0;
  color: #c7d0dc;
}

.footer-grid a:hover {
  color: #f6cd63;
}

.footer-brand strong {
  color: var(--white);
}

.footer-bottom {
  margin-top: 50px;
  padding-top: 22px;
  display: flex;
  justify-content: space-between;
  gap: 20px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  color: #98a7b9;
  font-size: 0.85rem;
}

/* Responsive */

@media (max-width: 920px) {
  .desktop-navigation {
    display: none;
  }

  .hero-grid,
  .about-grid,
  .donation-grid,
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 48px;
  }

  .hero-media {
    min-height: 560px;
    max-width: 680px;
  }

  .programme-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .stats-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .transparency-panel {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .site-container {
    width: min(100% - 26px, 1160px);
  }

  .section {
    padding: 68px 0;
  }

  .hero {
    padding: 56px 0 70px;
  }

  .hero h1 {
    font-size: 3rem;
  }

  .hero-media {
    min-height: 460px;
    border-radius: 24px;
  }

  .hero-message {
    left: 16px;
    right: 16px;
    bottom: 16px;
    padding: 18px;
  }

  .section-heading {
    display: block;
  }

  .programme-grid,
  .stats-grid,
  .story-grid,
  .footer-grid {
    grid-template-columns: 1fr;
  }

  .appeal-content,
  .footer-bottom {
    min-height: auto;
    padding: 18px 0;
    align-items: flex-start;
    flex-direction: column;
  }
}

/* Trust, governance and involvement */

.section-action {
  margin-top: 34px;
  text-align: center;
}

.involvement-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 26px;
}

.involvement-card {
  padding: 44px;
  border: 1px solid var(--border);
  border-radius: 28px;
  background: var(--white);
  box-shadow: 0 18px 50px rgba(11, 31, 58, 0.08);
}

.involvement-card h2,
.story-feature-copy h2,
.partnership-cta h2 {
  margin: 0 0 18px;
  color: var(--charity-navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(2.2rem, 4vw, 3.6rem);
  line-height: 1.08;
}

.involvement-card p {
  color: var(--muted);
}

.involvement-card-dark {
  background: var(--charity-navy);
  color: var(--white);
}

.involvement-card-dark h2 {
  color: var(--white);
}

.involvement-card-dark p {
  color: #cad5e0;
}

.light-button {
  min-height: 50px;
  padding: 0 24px;
  display: inline-flex;
  align-items: center;
  border-radius: 999px;
  background: var(--white);
  color: var(--charity-navy);
  font-weight: 800;
}

.story-feature {
  background: var(--white);
}

.story-feature-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 74px;
  align-items: center;
}

.story-feature-image {
  position: relative;
  min-height: 560px;
  overflow: hidden;
  border-radius: 28px;
  box-shadow: 0 24px 65px rgba(11, 31, 58, 0.14);
}

.story-feature-copy p {
  color: var(--muted);
  font-size: 1.06rem;
}

.reports-grid,
.partnership-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}

.report-card,
.partnership-grid article {
  padding: 32px;
  border: 1px solid var(--border);
  border-radius: 22px;
  background: var(--white);
  box-shadow: 0 12px 36px rgba(11, 31, 58, 0.07);
}

.report-card span {
  color: var(--charity-gold);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.report-card h2,
.partnership-grid h2 {
  color: var(--charity-navy);
}

.report-card p,
.partnership-grid p {
  color: var(--muted);
}

.report-card strong {
  color: var(--charity-green);
}

.report-contact,
.partnership-cta {
  margin-top: 42px;
  padding: 38px;
  border-radius: 24px;
  background: var(--charity-cream);
}

.report-contact {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 30px;
}

.policy-content {
  max-width: 840px;
}

.policy-content h2 {
  margin-top: 42px;
  color: var(--charity-navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;
}

.policy-content p,
.policy-content li {
  color: var(--muted);
  font-size: 1.04rem;
}

.policy-content li {
  margin-bottom: 12px;
}

.policy-notice {
  margin-top: 40px;
  padding: 28px;
  border-left: 5px solid var(--charity-gold);
  border-radius: 16px;
  background: var(--charity-cream);
}

.feature-list {
  padding-left: 20px;
}

.feature-list li {
  margin-bottom: 14px;
  color: var(--muted);
}

.not-found-page {
  min-height: 75vh;
  display: grid;
  place-items: center;
  background:
    radial-gradient(
      circle at 80% 20%,
      rgba(217, 170, 43, 0.17),
      transparent 28%
    ),
    var(--charity-soft);
}

.not-found-content {
  max-width: 780px;
  padding: 90px 0;
}

.not-found-content h1 {
  margin: 0;
  color: var(--charity-navy);
  font-family: Georgia, "Times New Roman", serif;
  font-size: clamp(3.2rem, 7vw, 6rem);
  line-height: 1;
}

.not-found-content > p:last-of-type {
  max-width: 620px;
  color: var(--muted);
  font-size: 1.12rem;
}

@media (max-width: 920px) {
  .involvement-grid,
  .story-feature-grid,
  .reports-grid,
  .partnership-grid {
    grid-template-columns: 1fr;
  }

  .story-feature-image {
    min-height: 440px;
  }

  .report-contact {
    align-items: flex-start;
    flex-direction: column;
  }
}

@media (max-width: 640px) {
  .involvement-card,
  .report-card,
  .partnership-grid article,
  .report-contact,
  .partnership-cta {
    padding: 26px;
  }

  .story-feature-image {
    min-height: 340px;
  }
}

/* =========================================================
   PROFESSIONAL ACTIVE NAVIGATION STATES
   ========================================================= */

.navbar-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  padding: 12px 15px;
  border-radius: 12px;
  color: var(--colour-navy-950);
  font-size: 0.94rem;
  font-weight: 750;
  transition:
    color var(--transition-fast),
    background-color var(--transition-fast),
    transform var(--transition-fast);
}

.navbar-link:hover {
  background: rgba(232, 177, 31, 0.09);
  color: var(--colour-navy-950);
}

.navbar-link-active {
  background: rgba(232, 177, 31, 0.12);
  color: var(--colour-navy-950);
}

.navbar-link-active::after {
  position: absolute;
  right: 15px;
  bottom: 5px;
  left: 15px;
  height: 3px;
  border-radius: 999px;
  background: var(--colour-gold-500);
  content: "";
}

.navbar-link-active:hover {
  background: rgba(232, 177, 31, 0.16);
}

.navbar-donate-active {
  outline: 3px solid rgba(232, 177, 31, 0.28);
  outline-offset: 4px;
  box-shadow: 0 12px 28px rgba(204, 148, 0, 0.28);
}

@media (max-width: 980px) {
  .navbar-link {
    justify-content: space-between;
    padding: 16px 14px;
  }

  .navbar-link-active {
    border-left: 4px solid var(--colour-gold-500);
    border-radius: 8px;
    background: rgba(232, 177, 31, 0.12);
  }

  .navbar-link-active::after {
    display: none;
  }
}

/* =========================================================
   PROFESSIONAL SOCIAL MEDIA CARDS
   ========================================================= */

.social-section {
  overflow: hidden;
  background:
    radial-gradient(
      circle at 100% 0%,
      rgba(232, 177, 31, 0.08),
      transparent 28%
    ),
    var(--colour-white);
}

.social-platform-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 24px;
}

.social-platform-card {
  --platform-colour: var(--colour-navy-950);
  --platform-soft: rgba(6, 23, 46, 0.08);

  position: relative;
  display: flex;
  min-height: 310px;
  overflow: hidden;
  flex-direction: column;
  padding: 28px;
  border: 1px solid var(--colour-border);
  border-radius: var(--radius-large);
  background: var(--colour-white);
  box-shadow: var(--shadow-small);
  isolation: isolate;
  transition:
    border-color var(--transition-standard),
    box-shadow var(--transition-standard),
    transform var(--transition-standard);
}

.social-platform-card::before {
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(
      145deg,
      var(--platform-soft),
      transparent 48%
    );
  content: "";
  opacity: 0;
  transition: opacity var(--transition-standard);
}

.social-platform-card::after {
  position: absolute;
  top: -70px;
  right: -70px;
  z-index: -1;
  width: 180px;
  height: 180px;
  border-radius: 50%;
  background: var(--platform-soft);
  content: "";
  transform: scale(0.7);
  transition:
    opacity var(--transition-standard),
    transform var(--transition-standard);
  opacity: 0.55;
}

.social-platform-card:hover {
  border-color: var(--platform-colour);
  box-shadow: var(--shadow-medium);
  transform: translateY(-8px);
}

.social-platform-card:hover::before {
  opacity: 1;
}

.social-platform-card:hover::after {
  opacity: 1;
  transform: scale(1);
}

.social-platform-card:focus-visible {
  outline: 4px solid var(--platform-soft);
  outline-offset: 5px;
}

.social-platform-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.social-platform-number {
  color: var(--colour-gold-600);
  font-size: 0.78rem;
  font-weight: 850;
  letter-spacing: 0.14em;
}

.social-platform-icon {
  width: 58px;
  height: 58px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 18px;
  background: var(--platform-soft);
  color: var(--platform-colour);
  font-size: 1.7rem;
  transition:
    background-color var(--transition-standard),
    color var(--transition-standard),
    transform var(--transition-standard);
}

.social-platform-card:hover .social-platform-icon {
  background: var(--platform-colour);
  color: var(--colour-white);
  transform: rotate(-5deg) scale(1.08);
}

.social-platform-content {
  margin-top: 42px;
}

.social-platform-content h3 {
  margin: 0;
  color: var(--colour-navy-950);
  font-family: Georgia, "Times New Roman", serif;
  font-size: 2rem;
  font-weight: 500;
  line-height: 1.1;
}

.social-platform-content p {
  margin: 10px 0 0;
  color: var(--colour-muted);
  line-height: 1.5;
}

.social-platform-action {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-top: auto;
  padding-top: 28px;
  color: var(--colour-navy-950);
  font-weight: 850;
}

.social-platform-action span {
  transition: transform var(--transition-fast);
}

.social-platform-card:hover .social-platform-action span {
  transform: translate(3px, -3px);
}

/* Facebook */

.social-platform-facebook {
  --platform-colour: #1877f2;
  --platform-soft: rgba(24, 119, 242, 0.11);
}

/* Instagram */

.social-platform-instagram {
  --platform-colour: #c13584;
  --platform-soft: rgba(193, 53, 132, 0.11);
}

.social-platform-instagram .social-platform-icon {
  background:
    linear-gradient(
      135deg,
      rgba(245, 133, 41, 0.17),
      rgba(193, 53, 132, 0.17),
      rgba(64, 93, 230, 0.17)
    );
}

.social-platform-instagram:hover .social-platform-icon {
  background:
    linear-gradient(
      135deg,
      #f58529,
      #dd2a7b,
      #8134af,
      #515bd4
    );
}

/* TikTok */

.social-platform-tiktok {
  --platform-colour: #111111;
  --platform-soft: rgba(0, 242, 234, 0.1);
}

.social-platform-tiktok:hover {
  box-shadow:
    -5px 8px 0 rgba(0, 242, 234, 0.13),
    5px 12px 0 rgba(255, 0, 80, 0.1),
    var(--shadow-medium);
}

/* YouTube */

.social-platform-youtube {
  --platform-colour: #ff0000;
  --platform-soft: rgba(255, 0, 0, 0.1);
}

/* Linktree */

.social-platform-linktree {
  --platform-colour: #43e660;
  --platform-soft: rgba(67, 230, 96, 0.13);
}

.social-platform-linktree:hover .social-platform-icon {
  color: #071c3a;
}

@media (max-width: 950px) {
  .social-platform-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 620px) {
  .social-platform-grid {
    grid-template-columns: 1fr;
  }

  .social-platform-card {
    min-height: 280px;
    padding: 24px;
  }

  .social-platform-content {
    margin-top: 34px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .social-platform-card,
  .social-platform-card::before,
  .social-platform-card::after,
  .social-platform-icon,
  .social-platform-action span {
    transition: none;
  }

  .social-platform-card:hover {
    transform: none;
  }

  .social-platform-card:hover .social-platform-icon {
    transform: none;
  }
}
