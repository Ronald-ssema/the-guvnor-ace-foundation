                target="_blank"
                rel="noopener noreferrer"
                className={`social-platform-card ${social.className}`}
                aria-label={`Visit The Guvnor Ace Foundation on ${social.name}`}
              >
                <div className="social-platform-top">
                  <span className="social-platform-number">
                    {social.number}
                  </span>

