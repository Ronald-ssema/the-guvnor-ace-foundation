# Public browser-safe Supabase project configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only secret used by the Foundation Assistant
OPENAI_API_KEY=your-server-only-key

# Canonical production address
NEXT_PUBLIC_SITE_URL=https://www.theguvnoracefoundation.org

# Keep this stable across production instances that serve Server Actions
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=generate-a-32-byte-base64-key

# Server-only HMAC key used to anonymise identifiers for persistent rate limiting
RATE_LIMIT_SECRET=generate-at-least-32-random-bytes
