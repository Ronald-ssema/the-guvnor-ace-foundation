# Public browser configuration. The publishable key is intentionally public;
# never put a service-role key in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NEXT_PUBLIC_SITE_URL=https://www.theguvnoracefoundation.org

# Server-only secrets. Configure these in Vercel; do not commit real values.
OPENAI_API_KEY=replace-with-server-only-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Keep stable across production instances serving Server Actions
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=generate-a-32-byte-base64-key
